package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library_host {
    name: "telephony-configproto-generator-lib",
    srcs: [
        "src/main/java/**/*.java",
    ],
    static_libs: [
        "telephony-config-update-proto-lite",
        "jcommander",
    ],
}

// A tool to generate configdata protubuf file
java_binary_host {
    name: "telephony_configproto_generator",
    main_class: "com.android.telephony.tools.configdatagenerate.ConfigDataGenerator",
    static_libs: [
        "telephony-configproto-generator-lib",
    ],
}

// Tests for ConfigDataGenerator.
java_test_host {
    name: "TelephonyConfigProtoGeneratorTests",
    srcs: ["src/test/java/**/*.java"],
    static_libs: [
        "junit",
        "telephony-configproto-generator-lib",
    ],
    test_suites: ["general-tests"],
}
